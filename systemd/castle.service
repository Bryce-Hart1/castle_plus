# Runs castle++ under systemd: systemd supervises the buffer, and the buffer
# supervises the app backends. Because the backends are children in this unit's
# cgroup, systemd's default KillMode=control-group cleans them all up if castle
# itself is stopped or crashes. Logs (ours + the backends') go to journald.
#
# Install (adjust paths):
#   sudo cp castle /opt/castle/ && sudo cp -r config /opt/castle/
#   sudo cp systemd/castle.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now castle
[Unit]
Description=castle++ buffer (reverse proxy + process supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/castle
ExecStart=/opt/castle/castle --port 8080 --services /opt/castle/config/services.conf
Restart=on-failure
RestartSec=2

# Least privilege. Uncomment and create a 'castle' user for production; add
# CAP_NET_BIND_SERVICE only if castle must bind a port < 1024 directly (with the
# VPS/WireGuard ingress it can listen on a high port instead).
# User=castle
# Group=castle
# AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
